rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      // NOTE: Admins collection must be manually seeded or via trusted backend
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- User Validation ---
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email']) 
        && data.uid is string && data.uid.size() <= 128
        && data.email is string && data.email.size() <= 256
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100))
        && (!('loginPhone' in data) || (data.loginPhone is string && data.loginPhone.size() <= 15))
        && (!('token' in data) || (data.token is string && data.token.size() <= 2048));
    }

    // --- Rules ---

    // Users Collection
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin(); // Only admins can browse user list
      
      allow create: if isOwner(userId) 
        && isValidId(userId)
        && isValidUser(incoming())
        && incoming().uid == request.auth.uid;
        
      allow update: if isOwner(userId)
        && isValidUser(incoming())
        && (
          // Action: Profile Update
          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'lastLogin', 'token'])
        );
        
      allow delete: if isAdmin();
    }

    // Admins Collection
    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if false; // System defined
    }

    // Batches Collection (Cache)
    match /batches/{batchId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
