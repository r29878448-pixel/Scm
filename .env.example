# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# For Vercel/Render, set this as a secret in their respective dashboards.
GEMINI_API_KEY="your_gemini_api_key"
NEXT_PUBLIC_GEMINI_API_KEY="your_gemini_api_key"

# APP_URL: The URL where this applet is hosted.
# Used for self-referential links and metadata.
APP_URL="https://your-app-url.vercel.app"

# FIREBASE CONFIGURATION (If not using firebase-applet-config.json)
# NEXT_PUBLIC_FIREBASE_API_KEY=""
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
# NEXT_PUBLIC_FIREBASE_APP_ID=""
